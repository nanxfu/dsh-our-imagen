.tmp/

# 生成产物
imagen-output/
bench-results/
test/.build/

# Python 运行残留
__pycache__/
*.pyc

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# 设计预览产物
tools/.preview/

# 设计过程稿（截图与 HTML 预览，按 docs/PRE_RELEASE_SPEC.md 仅本地保留）
design-demos/

# 分发打包产物（npm run package）
dist/

# impeccable 工作产物（截图、live 会话、决策稿；仅本地保留）
.impeccable/

# 本地基准实验（含个人 Kaggle 账号元数据；仅本地保留）
bench/

# 本地开发文档与规格草稿（仅本地保留，磁盘文件不删）
docs/archive/
