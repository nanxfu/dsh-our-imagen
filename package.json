{
  "name": "dsh-our-imagen",
  "version": "0.13.0",
  "type": "module",
  "description": "Free image generation workbench backed by Kaggle GPUs",
  "license": "MIT",
  "author": "nanxfu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanxfu/dsh-our-imagen.git"
  },
  "homepage": "https://github.com/nanxfu/dsh-our-imagen#readme",
  "bugs": {
    "url": "https://github.com/nanxfu/dsh-our-imagen/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "kaggle",
    "image-generation",
    "stable-diffusion",
    "sdxl",
    "flux"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "shared/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "remote/*.py",
    "remote/**/*.py",
    "remote/contract.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "site:build": "node site/build.mjs",
    "models:build": "node tools/build-assets.mjs",
    "models:check": "node tools/build-assets.mjs --check",
    "package": "node scripts/package.mjs",
    "test": "node build.mjs && node tools/build-assets.mjs --check && node test/run-all.mjs",
    "test:contract": "node tools/build-assets.mjs --check && node test/run-all.mjs --group contract",
    "test:client": "node build.mjs && node test/run-all.mjs --group client",
    "test:host": "node test/run-all.mjs --group host",
    "test:loaded": "node test/verify-loaded.mjs",
    "test:session-pure": "node test/session-pure.mjs",
    "test:daemon": "python test/remote/run.py",
    "contract:gen": "node tools/gen-contract-json.mjs",
    "contract:check": "node tools/gen-contract-json.mjs --check",
    "clean": "node -e \"const fs = require('fs'); ['tools/.preview', '.impeccable/review', 'bench-results/gpu-live'].forEach(d => { try { fs.rmSync(d, { recursive: true, force: true }); console.log('Cleaned ' + d); } catch(e){} });\"",
    "test:live": "node test/kaggle-live.mjs",
    "test:gpu": "node test/gpu-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "gsap": "^3.15.1"
  }
}
