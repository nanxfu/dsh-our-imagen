    "queue_timeout": {
      "layer": "host",
      "status": null
    },
    "remote_error": {
      "layer": "host",
      "status": null
    },
    "reveal_failed": {
      "layer": "host",
      "status": 500
    },
    "session_absent": {
      "layer": "host",
      "status": null
    },
    "session_ended": {
      "layer": "host",
      "status": null
