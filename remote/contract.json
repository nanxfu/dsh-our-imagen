{
  "version": "0.3.0",
  "routes": {
    "generate": {
      "method": "POST",
      "path": "/generate"
    },
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "logs": {
      "method": "GET",
      "path": "/logs"
    },
    "shutdown": {
      "method": "POST",
      "path": "/shutdown"
    }
  },
  "healthPhases": [
    "booting",
    "installing",
    "loading",
    "ready",
    "error"
  ],
  "ntfyEvents": [
    "ready",
    "error"
  ],
  "limits": {
    "width": {
      "max": 1536,
      "min": 256,
      "step": 8
    },
    "height": {
      "max": 1536,
      "min": 256,
      "step": 8
    },
    "steps": {
      "max": 60,
      "min": 1
    },
    "cfg": {
      "max": 20,
      "min": 0
    },
    "count": {
      "max": 4,
      "min": 1
    },
    "seed": {
      "max": 2147483647
    },
    "prompt": {
      "maxChars": 2000
    },
    "negativePrompt": {
      "maxChars": 1000
    },
    "historyTool": {
      "defaultLimit": 5,
      "maxLimit": 30
    }
  },
  "errorCodes": {
    "auth_required": {
      "layer": "host",
      "status": null
    },
    "cli_missing": {
      "layer": "host",
      "status": null
    },
    "cli_timeout": {
      "layer": "host",
      "status": null
    },
    "disposed": {
      "layer": "host",
      "status": null
    },
    "empty_result": {
      "layer": "host",
      "status": null
    },
    "generate_failed": {
      "layer": "host",
      "status": null
    },
    "generation_failed": {
      "layer": "remote",
      "status": null
    },
    "health_failed": {
      "layer": "host",
      "status": null
    },
    "internal_error": {
      "layer": "host",
      "status": 500
    },
    "invalid_body": {
      "layer": "host",
      "status": 400
    },
    "invalid_path": {
      "layer": "host",
      "status": 400
    },
    "invalid_prompt": {
      "layer": "host",
      "status": 400
    },
    "invalid_request": {
      "layer": "host",
      "status": 400
    },
    "load_failed": {
      "layer": "remote",
      "status": null
    },
    "not_found": {
      "layer": "host",
      "status": 404
    },
    "oom": {
      "layer": "remote",
      "status": null
    },
    "output_missing": {
      "layer": "host",
      "status": 404
